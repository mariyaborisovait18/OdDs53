<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:OnboardingApp.Views"  
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="OnboardingApp.Views.EmployeesView"  
        Title="EmployeesView" Height="400" Width="400">

    <StackPanel Margin="0,10,10,10">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="50" Text="id" 
                     md:HintAssist.Hint="Id"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"/>
            <TextBox Width="100" Text="Фамилия" 
                     md:HintAssist.Hint="Фамилия"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"/>
            <TextBox Width="130" Text="Отдел" 
                     md:HintAssist.Hint="Отдел"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"/>
            <Button Content="Добавить" Command="{Binding AddEmployeeCommand}" RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-0.334"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
        </StackPanel>
        <ListView ItemsSource="{Binding Employees}" av:ItemsSource="{av:SampleData ItemCount=5}" Height="248" Width="376">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Id}" Width="50"/>
                        <TextBlock Width="100"><Run Language="ru-ru" Text="Кошелев"/></TextBlock>
                        <TextBlock Width="100"><Run Language="ru-ru" Text="Отдел кадров"/></TextBlock>
                        <Button Content="Удалить" 
                                Command="{Binding DataContext.RemoveEmployeeCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"  
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</Window>


