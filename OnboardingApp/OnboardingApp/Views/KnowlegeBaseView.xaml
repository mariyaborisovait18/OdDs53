<UserControl x:Class="OnboardingApp.Views.KnowlegeBaseView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pdf="clr-namespace:BitMiracle.Docotic.Pdf;assembly=BitMiracle.Docotic.Pdf"
        xmlns:converters="clr-namespace:OnboardingApp.Converters"
        xmlns:syncfusion="clr-namespace:Syncfusion.Windows.PdfViewer;assembly=Syncfusion.PdfViewer.WPF"
        xmlns:vm="clr-namespace:OnboardingApp.ViewModels" 
        xmlns:local="clr-namespace:OnboardingApp"
        mc:Ignorable="d">


    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:KnowlegeBaseViewModel/>
    </UserControl.DataContext>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="542*"/>
            <ColumnDefinition Width="133*"/>
            <ColumnDefinition Width="112*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="32"/>
            <!-- Auto - Высота автоматически подстраивается под содержимое -->
            <RowDefinition Height="Auto" MinHeight="68"/>
            <RowDefinition Height="281*"/>
            <RowDefinition Height="69*"/>
            <!--<RowDefinition Height="347*"/>-->
        </Grid.RowDefinitions>

        <TextBlock Text="База знаний" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="29,0,0,0" Height="32" Width="134" />

        <!-- Поиск и фильтрация-->
        <StackPanel Orientation="Horizontal" Margin="10,10,10,10" Grid.Row="1" Grid.ColumnSpan="3">
            <!-- Поле поиска -->
            <Grid Width="300">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" x:Name="SearchTextBox" Margin="0" VerticalAlignment="Center" />
                <TextBlock Text="Поиск..." Foreground="LightGray" 
                           VerticalAlignment="Center" Margin="5,0,0,0" 
                           IsHitTestVisible="False" 
                           Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}}"/>
            </Grid>
            <!-- Категория -->
            <ComboBox ItemsSource="{Binding Categories}" 
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Width="154" Margin="10,0,0,0" Height="30" VerticalAlignment="Center"/>
            <!-- Кнопка "Поиск" -->
            <Button Content="Поиск" Command="{Binding RefreshCommand}" Margin="5,0,0,0" Width="83" Height="30" VerticalAlignment="Center"/>
            <!--Кнопка "обратно в меню"-->
            <Button Content="Назад в меню" Command="{Binding GoToMainMenuCommand}" Margin="10" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- DataGrid с данными -->
        <DataGrid x:Name="ArticlesDataGrid" Grid.Row="2"
                  
                   SelectionChanged="ArticlesDataGrid_SelectionChanged"
                   ItemsSource="{Binding FilteredArticles}" 
                   AutoGenerateColumns="False" 
                   Margin="10,10,10,10" IsReadOnly="True" Grid.ColumnSpan="3" Grid.RowSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="110"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedDate, StringFormat=d}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Пример просмотра PDF. Возможно, вы будете использовать другой контрол -->

        <!-- <syncfusion:PdfViewerControl x:Name="pdfViewer"></syncfusion:PdfViewerControl>-->

        <!-- Изменён на Grid.Row="1" -->
    </Grid>
</UserControl>
