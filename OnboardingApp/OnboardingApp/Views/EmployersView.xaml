<UserControl
    x:Class="OnboardingApp.Views.EmployersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:local="clr-namespace:OnboardingApp.Views"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"      
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    Loaded="UserControl_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid ItemsSource="{Binding Employees}" x:Name="List" FontSize="16" FontWeight="Bold" Margin="10" AutoGenerateColumns="False" 
                  SelectionChanged="List_SelectionChanged" Grid.Row="0" Grid.Column="0">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Text1}" Header="ID" Width="180"/>
                <DataGridTextColumn Binding="{Binding Text2}" Header="Name" Width="200"/>
                <DataGridTextColumn Binding="{Binding Text3}" Header="Department" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="0" Margin="10">
            <Grid Margin="5">
                <TextBox x:Name="TextBoxID" Margin="0,20,0,0" Text="{Binding NewEmployeeId, Mode=TwoWay}"/>
                <TextBlock Text="ID" VerticalAlignment="Top" Foreground="Gray" Margin="5,0,0,0"/>
            </Grid>

            <Grid Margin="5">
                <TextBox x:Name="TextBoxName" Margin="0,20,0,0" Text="{Binding NewEmployeeName, Mode=TwoWay}"/>
                <TextBlock Text="Name" VerticalAlignment="Top" Foreground="Gray" Margin="5,0,0,0"/>
            </Grid>

            <Grid Margin="5">
                <TextBox x:Name="TextBoxDepartment" Margin="0,20,0,0" Text="{Binding NewEmployeeDepartment, Mode=TwoWay}"/>
                <TextBlock Text="Department" VerticalAlignment="Top" Foreground="Gray" Margin="5,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- Кнопки теперь находятся в верхней части правой колонки -->
        <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="1" Margin="10" VerticalAlignment="Top" HorizontalAlignment="Right">
            <Button Content="Добавить сотрудника" Command="{s:Action AddEmployeeCommand}" 
                    HorizontalAlignment="Stretch" Margin="5" Click="Button_Click_4"/>
            <Button Content="Назад в меню" Command="{s:Action GoToMainMenuCommand}" 
                    HorizontalAlignment="Stretch" Margin="5"/>
        </StackPanel>
    </Grid>
</UserControl>









