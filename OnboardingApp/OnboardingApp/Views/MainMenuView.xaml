                                    СПИСОК
                                    <LineBreak />
                                    СОТРУДНИКОВ
                                </TextBlock>
                            </Button>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Width = "165" Height = "165" Effect = "{StaticResource EffectShadow1}" Margin = "10" CornerRadius = "95">
                            <Border.Background>
