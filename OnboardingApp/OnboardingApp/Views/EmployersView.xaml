<UserControl
    x:Class="OnboardingApp.Views.EmployersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:local="clr-namespace:OnboardingApp.Views"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"      
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    Height="600" Width="600" Loaded="UserControl_Loaded">

    <Grid>
        <StackPanel>
            <Button Content="Go to main menu" Command="{s:Action GoToMainMenuCommand}" Click="Button_Click_3"/>
            <DataGrid x:Name="List" ItemsSource="{Binding Employees}" FontSize="16" FontWeight="Bold" Margin="10" AutoGenerateColumns="False" SelectionChanged="List_SelectionChanged" Height="68" Width="576">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Path=Text1}" IsReadOnly="False" Header="ID" Width="100"/>
                    <DataGridTextColumn Binding="{Binding Path=Text2}" IsReadOnly="False" Header="Name" Width="180"/>
                    <DataGridTextColumn Binding="{Binding Path=Text3}" IsReadOnly="False"  Header="Department" Width="*"/>


                </DataGrid.Columns>

            </DataGrid>


        </StackPanel>
    </Grid>
</UserControl>


